{
  "version": 2,
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "api/index.js" },
    { "source": "/guanli", "destination": "/guanli/index.html" },
    { "source": "/guanli/", "destination": "/guanli/index.html" },
    { "source": "/guanli/login", "destination": "/guanli/login/index.html" },
    { "source": "/guanli/login/", "destination": "/guanli/login/index.html" }
  ],
  "headers": [
    {
      "source": "/guanli/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/guanli/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
